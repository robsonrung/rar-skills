{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rar-skills/implementation-routing-plan.schema.json",
  "title": "Approved implementation routing plan",
  "description": "The machine record for model routes approved before an implementation run starts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "approval",
    "routes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "content_sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "Readable task or PRD artifact path."
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$",
                "description": "SHA-256 of the canonical task content. Normalize line endings to LF and exclude only an exact standalone **Status:** ready-for-agent, in-progress, done, or blocked line before hashing."
              }
            }
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "decided_at",
        "reference",
        "scope_digest",
        "routes_digest"
      ],
      "properties": {
        "status": {
          "const": "approved"
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "description": "Durable pointer to the user approval."
        },
        "scope_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 of the canonical scope.inputs value."
        },
        "routes_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 of the normalized approved route list."
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/route"
      }
    }
  },
  "definitions": {
    "runner": {
      "type": "string",
      "enum": [
        "codex",
        "claude",
        "pi",
        "grok",
        "gemini",
        "cline"
      ]
    },
    "effort": {
      "type": "string",
      "minLength": 1,
      "description": "Validate against shared/model-routing.json and the exact host or adapter capability."
    },
    "native_transport": {
      "type": "string",
      "enum": [
        "subagent",
        "thread"
      ]
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "transport",
        "capability_source",
        "supported_efforts"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "description": "Host that exposed the checked native delegation capability."
        },
        "transport": {
          "$ref": "#/definitions/native_transport"
        },
        "capability_source": {
          "type": "string",
          "minLength": 1,
          "description": "Evidence for this host's exact model, effort, and delegation capability."
        },
        "supported_efforts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/effort"
          },
          "description": "Efforts the checked native host supports for this selected route."
        }
      }
    },
    "unavailable": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "const": "block"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "seat",
            "runner",
            "model",
            "model_verification",
            "effort",
            "effort_control",
            "mode"
          ],
          "properties": {
            "action": {
              "const": "use"
            },
            "seat": {
              "type": "string",
              "minLength": 1
            },
            "runner": {
              "$ref": "#/definitions/runner"
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "model_verification": {
              "enum": [
                "required",
                "allow_unverified"
              ]
            },
            "effort": {
              "oneOf": [
                {
                  "$ref": "#/definitions/effort"
                },
                {
                  "type": "null"
                }
              ]
            },
            "effort_control": {
              "enum": [
                "runner",
                "runtime",
                "native"
              ]
            },
            "mode": {
              "enum": [
                "runner",
                "native"
              ]
            },
            "native": {
              "$ref": "#/definitions/native"
            }
          }
        }
      ]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "task_id",
        "input_path",
        "track",
        "role",
        "seat",
        "runner",
        "model",
        "model_verification",
        "effort",
        "effort_control",
        "mode",
        "unavailable"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "input_path": {
          "type": "string",
          "minLength": 1,
          "description": "Path of the scope input that defines this task."
        },
        "track": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "implementer",
            "reviewer"
          ]
        },
        "seat": {
          "type": "string",
          "minLength": 1
        },
        "runner": {
          "$ref": "#/definitions/runner"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "model_verification": {
          "enum": [
            "required",
            "allow_unverified"
          ],
          "description": "Whether this user-approved route needs an observed serving-model receipt or explicitly permits an unverified configured transport."
        },
        "effort": {
          "oneOf": [
            {
              "$ref": "#/definitions/effort"
            },
            {
              "type": "null"
            }
          ]
        },
        "effort_control": {
          "enum": [
            "runner",
            "runtime",
            "native"
          ]
        },
        "mode": {
          "enum": [
            "runner",
            "native"
          ]
        },
        "native": {
          "$ref": "#/definitions/native"
        },
        "unavailable": {
          "$ref": "#/definitions/unavailable"
        },
        "source_sharing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "scope",
            "follow_ups",
            "exclusions",
            "reference"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "follow_ups": {
              "type": "string",
              "minLength": 1
            },
            "exclusions": {
              "type": "string",
              "minLength": 1
            },
            "reference": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "recovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "review_cycles",
            "evidence_recoveries"
          ],
          "properties": {
            "review_cycles": {
              "type": "integer",
              "minimum": 1
            },
            "evidence_recoveries": {
              "type": "integer",
              "minimum": 1
            }
          },
          "description": "Approved category limits within the total call and time budget. Defaults remain three cycles and one evidence recovery."
        },
        "context_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_bytes"
          ],
          "properties": {
            "max_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "max_bytes": {
                    "minimum": 24001
                  }
                }
              },
              "then": {
                "required": [
                  "reason"
                ]
              }
            }
          ],
          "description": "Maximum UTF-8 bytes of the complete launcher-rendered worker input. Default 24000. Larger limits need a recorded reason and are bound by the route approval digest. Host-added context and retained role history remain unmeasured."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "effort_control": {
                "const": "runner"
              }
            }
          },
          "then": {
            "properties": {
              "effort": {
                "$ref": "#/definitions/effort"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "effort_control": {
                "const": "runtime"
              }
            }
          },
          "then": {
            "properties": {
              "effort": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "effort_control": {
                "const": "native"
              }
            }
          },
          "then": {
            "required": [
              "native"
            ],
            "properties": {
              "effort": {
                "$ref": "#/definitions/effort"
              },
              "mode": {
                "const": "native"
              }
            }
          }
        }
      ]
    }
  }
}
