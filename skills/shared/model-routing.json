  "policy": {
    "risk_levels": [
      "normal",
      "high"
    ],
    "high_risk_triggers": [
      "Unresolved requirements or contradictory evidence",
      "Authorization, security, privacy, money, or irreversible effects",
      "Data migrations, concurrency, or public contract changes",
      "Weak acceptance checks or scope exceeding the planned slice"
    ],
    "escalation_triggers": [
      "Repeated repair without new evidence",
      "Unknown causal chain",
      "Reviewer finds a blocking design defect",
      "Implementation cannot state the behavior and invariant it preserves"
    ],
    "review_inputs": [
      "Original requirements and acceptance criteria",
      "Full diff and relevant source files",
      "Affected interfaces and invariants",
      "Captured test results and known uncertainty"
    ],
    "efficiency": [
      "Gather facts with bounded workers",
      "Use tools directly for deterministic work",
      "Parallelize only independent authorized work",
      "Reuse each role context without sharing implementer and reviewer conversations",
      "Measure total tokens, elapsed time, cost, and repair cycles per accepted result"
    ],
    "evaluation": [
      "Compare representative tasks per task class with the same starting revision and acceptance checks",
      "Keep independent review and failure cases",
      "Retain cheaper routes only where observed quality holds",
      "A small trial does not prove universal equivalence"
    ],
    "escalation_authority": "Resolve candidates before approval. Later changes require the calling workflow authority; never silently change an approved route.",
    "seat_admission": {
      "zdr_required": true,
      "rule": "Admit a seat only when at least one serving provider offers a verified zero-data-retention policy. Benchmark position never overrides this rule.",
      "decided_at": "2026-09-22",
      "rejected": [
        {
          "model": "xiaomi/mimo-v2.6-pro",
          "reason": "No ZDR-capable provider. Rejected 2026-09-22 despite a frontier cost position (Artificial Analysis Intelligence Index 46 at $0.13 per task)."
        }
      ]
    }
  },
  "providers": {
    "claude": {
      "runner": "claude",
      "cross": "openai"
    },
