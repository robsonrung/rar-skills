      "cross": "openai"
    }
  },
  "default_provider": "claude",
  "cross_provider_roles": [
    "reviewer",
    "respondent"
  ],
  "gateway_policy": {
    "gateway": "openrouter",
    "zdr": true,
    "data_collection": "deny",
    "require_parameters": true
  },
  "routes": {
    "lookup": {
      "purpose": "Find facts, read code, run checks, or write routine documentation.",
      "use_when": "A mistake is cheap to spot and nothing is decided or designed.",
      "risk_route": "analysis",
      "roles": {
        "worker": {
          "claude": "sonnet:medium",
          "openai": "terra:medium",
          "grok": "grok:medium",
          "gemini": "gemini:runtime"
        }
      }
    },
    "routine-code": {
      "purpose": "Implement a bounded change with stable interfaces: a function, a mechanical edit, a known-cause fix, or tests from agreed cases.",
      "use_when": "Tests, a build, or a diff decide correctness and the scope is one spec or a few files.",
      "risk_route": "hard-code",
      "roles": {
        "implementer": {
          "claude": "sonnet:medium",
          "openai": "terra:medium",
          "grok": "grok:high",
          "gemini": "gemini:runtime",
          "muse": "muse-wonder-full:high"
        },
        "reviewer": {
          "claude": "opus:high",
          "openai": "sol:high",
          "grok": "grok:high",
          "gemini": "gemini:runtime"
        }
      }
    },
    "standard-code": {
      "purpose": "Implement everyday engineering work that crosses modules or needs local design judgment.",
      "use_when": "Acceptance checks exist, but the change needs judgment the checks do not cover.",
      "risk_route": "hard-code",
      "roles": {
        "implementer": {
          "claude": "opus:medium",
          "openai": "sol:medium",
          "grok": "grok:high",
          "gemini": "gemini:runtime",
          "muse": "muse-wonder-full:high"
        },
        "reviewer": {
          "claude": "opus:high",
          "openai": "sol:high",
          "grok": "grok:high",
          "gemini": "gemini:runtime"
        }
      }
    },
    "hard-code": {
      "purpose": "Implement work where an early mistake compounds: a migration, a sensitive or public contract, a major refactor, or a long unattended run.",
      "use_when": "A policy.high_risk_triggers entry applies, or the last attempt failed on a wrong idea.",
      "risk_route": "hard-code",
      "roles": {
        "implementer": {
          "claude": "fable:high",
          "openai": "astra:high",
          "grok": "grok:high",
          "gemini": "gemini:runtime",
          "muse": "muse-wonder-full:xhigh"
        },
        "reviewer": {
          "claude": "fable:high",
          "openai": "astra:high",
          "grok": "grok:high",
          "gemini": "gemini:runtime"
        }
      }
    },
    "analysis": {
      "purpose": "Research, diagnose, design tests, or decide an architecture or an ambiguous problem.",
      "use_when": "The cause is unknown, the evidence conflicts, or nobody will check the judgment.",
      "risk_route": "analysis",
      "roles": {
        "worker": {
          "claude": "fable:high",
          "openai": "astra:high",
          "grok": "grok:high",
          "gemini": "gemini:runtime"
        }
      }
    },
    "deep-analysis": {
      "purpose": "Analyze exhaustively when a first analysis left a recorded gap.",
      "use_when": "An analysis route already ran and its gap is written down.",
      "risk_route": "deep-analysis",
      "roles": {
        "worker": {
          "claude": "fable:high",
          "openai": "astra:xhigh",
          "grok": "grok:high",
          "gemini": "gemini:runtime"
        }
      }
    },
    "review": {
      "purpose": "Review a diff, a design, or captured evidence independently of its author.",
      "use_when": "One bounded change or document with local risk.",
      "risk_route": "deep-review",
      "roles": {
        "reviewer": {
          "claude": "opus:high",
          "openai": "sol:high",
          "grok": "grok:high",
          "gemini": "gemini:runtime"
        }
      }
    },
    "deep-review": {
      "purpose": "Review a security boundary, a migration, a public contract, or integrated work across seams.",
      "use_when": "A policy.high_risk_triggers entry applies to the change under review.",
      "risk_route": "deep-review",
      "roles": {
        "reviewer": {
          "claude": "fable:high",
          "openai": "astra:xhigh",
          "grok": "grok:high",
          "gemini": "gemini:runtime"
        }
      }
