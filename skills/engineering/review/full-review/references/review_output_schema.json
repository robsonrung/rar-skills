{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Full Review Output",
  "type": "object",
  "required": [
    "review_plan",
    "comments",
    "verdict",
    "summary"
  ],
  "properties": {
    "review_plan": {
      "type": "object",
      "required": [
        "scope",
        "risk",
        "seats",
        "effort",
        "planned_routes",
        "completed_routes",
        "unavailable_routes",
        "verification"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "focused",
            "seam",
            "deep"
          ]
        },
        "risk": {
          "type": "string",
          "minLength": 1
        },
        "seats": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "effort": {
          "type": "string",
          "minLength": 1
        },
        "planned_routes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "completed_routes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unavailable_routes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "confidence",
          "category",
          "path",
          "line_start",
          "line_end",
          "title",
          "problem",
          "evidence",
          "suggested_fix",
          "tests_to_run",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "spec",
              "correctness",
              "security",
              "reliability",
              "performance",
              "maintainability",
              "tests",
              "docs",
              "style",
              "tooling"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "suggested_fix": {
            "type": "string",
            "minLength": 1
          },
          "tests_to_run": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "description": "Approved route that raised the finding."
          },
          "corroborated_by": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Other approved routes that raised the same finding. This does not change severity or confidence."
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "unverified",
              "refuted"
            ]
          },
          "related_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      },
      "description": "Complete durable findings after evidence and confidence filtering. Human summary limits do not remove entries."
    },
    "verdict": {
      "type": "string",
      "enum": [
        "APPROVE",
        "COMMENT",
        "REQUEST_CHANGES"
      ]
    },
    "summary": {
      "type": "object",
      "required": [
        "files_reviewed",
        "issues_total",
        "by_severity"
      ],
      "properties": {
        "files_reviewed": {
          "type": "integer",
          "minimum": 0
        },
        "issues_total": {
          "type": "integer",
          "minimum": 0
        },
        "by_severity": {
          "type": "object",
          "required": [
            "CRITICAL",
            "HIGH",
            "MEDIUM",
            "LOW"
          ],
          "properties": {
            "CRITICAL": {
              "type": "integer",
              "minimum": 0
            },
            "HIGH": {
              "type": "integer",
              "minimum": 0
            },
            "MEDIUM": {
              "type": "integer",
              "minimum": 0
            },
            "LOW": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "coverage_limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "description": "Filled only in gate mode.",
      "required": [
        "tiers",
        "coverage",
        "checks",
        "preview"
      ],
      "properties": {
        "tiers": {
          "type": "object",
          "description": "The scope contract, declared before any seat starts.",
          "required": [
            "will_review",
            "spot_check",
            "wont_review"
          ],
          "properties": {
            "will_review": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "spot_check": {
              "type": "object",
              "required": [
                "files",
                "sampling"
              ],
              "properties": {
                "files": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "sampling": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Sample size and how the sample was chosen."
                }
              },
              "additionalProperties": false
            },
            "wont_review": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "reason"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "coverage": {
          "type": "array",
          "description": "One row per will-review and spot-check file. A declared file missing here is a broken contract.",
          "items": {
            "type": "object",
            "required": [
              "path",
              "outcome"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "clean",
                  "finding",
                  "spot-checked",
                  "skipped"
                ]
              },
              "note": {
                "type": "string",
                "description": "Required for skipped: what forced the skip."
              }
            },
            "additionalProperties": false
          }
        },
        "checks": {
          "type": "array",
          "description": "Embedded verbatim from verify-changes; item shape owned by verify-changes/references/checks-schema.json.",
          "items": {
            "type": "object",
            "required": [
              "command",
              "result"
            ]
          }
        },
        "preview": {
          "type": "object",
          "required": [
            "attempted",
            "result"
          ],
          "properties": {
            "attempted": {
              "type": "boolean"
            },
            "url": {
              "type": "string"
            },
            "result": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "skipped"
              ]
            },
            "notes": {
              "type": "string",
              "description": "What was observed, or why the preview was skipped."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
