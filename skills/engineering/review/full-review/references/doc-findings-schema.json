{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document Review Findings",
  "type": "object",
  "required": [
    "review_plan",
    "reviewer",
    "findings",
    "residual_risks",
    "deferred_questions"
  ],
  "properties": {
    "review_plan": {
      "type": "object",
      "required": [
        "scope",
        "risk",
        "seats",
        "effort",
        "planned_routes",
        "completed_routes",
        "unavailable_routes",
        "verification"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "focused",
            "seam",
            "deep"
          ]
        },
        "risk": {
          "type": "string",
          "minLength": 1
        },
        "seats": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "effort": {
          "type": "string",
          "minLength": 1
        },
        "planned_routes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "completed_routes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unavailable_routes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "severity",
          "section",
          "why_it_matters",
          "finding_type",
          "suggested_fix",
          "confidence",
          "evidence",
          "verification"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "why_it_matters": {
            "type": "string",
            "minLength": 1
          },
          "finding_type": {
            "type": "string",
            "enum": [
              "error",
              "omission",
              "question"
            ]
          },
          "suggested_fix": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verification": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "deferred_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
